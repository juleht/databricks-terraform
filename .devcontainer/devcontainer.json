{
  "name": "Databricks Terraform",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.2": {},
    "ghcr.io/devcontainers/features/terraform:1": {}
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],
  "runArgs": ["--env-file", ".env", "--cpus=2", "--memory=4g"],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "DISABLE_AUTOUPDATER": "1"
  },
  "postCreateCommand": "git config --global user.name \"$GIT_AUTHOR_NAME\" && git config --global user.email \"$GIT_AUTHOR_EMAIL\"",
  "customizations": {
    "vscode": {
      "extensions": ["hashicorp.terraform", "redhat.vscode-yaml", "github.vscode-github-actions"]
    }
  }
}
